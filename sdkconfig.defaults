# sdkconfig.defaults - ESP-IDF configuration defaults
#
# 이 파일은 `idf.py set-target esp32` 후 sdkconfig에 병합됨.
# 사용자가 sdkconfig를 직접 수정하지 않아도 이 기본값들이 적용됨.

# ---- BLE - NimBLE 사용 (Bluedroid 비활성) ----
# NimBLE-Arduino 라이브러리가 자체 NimBLE 스텍 포함하므로
# ESP-IDF Bluedroid는 비활성화하여 메모리 절약
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=n        # ESP-IDF NimBLE 아님 - NimBLE-Arduino 자체 구현 사용
CONFIG_BT_BLUEDROID_ENABLED=n     # Bluedroid 비활성
# BT 컨트롤러는 활성 (BLE radio)
CONFIG_BTDM_CONTROLLER_MODE_BTDM=y

# ---- WiFi (BLE 우선 Optimum coex 모드) ----
# BLE와 WiFi 동시 사용 - BLE pairing 안정성 최우선
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP32_WIFI_SW_COEXIST_ENABLE=y
# Coex 모드: 0=Performance, 1=Balanced, 2=Optimum (BLE 우선)
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
# BLE 우선 모드 - WiFi가 BLE에 간섭 안 일으키도록 BLE에 더 많은 라디오 슬롯 할당
CONFIG_BT_COEX_TYPE=n   # 이 설정은 BT classic에만 영향, NimBLE는 별도 처리

# WiFi 전력 관리 (BLE에 영향 최소화)
CONFIG_ESP32_WIFI_NVS_ENABLED=y
CONFIG_ESP32_WIFI_SOFTAP_SUPPORT=n  # AP 모드 비활성 (STA만 사용으로 메모리 절약)
CONFIG_ESP32_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP32_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP32_WIFI_TX_BUFFER=n
CONFIG_ESP32_WIFI_DYNAMIC_TX_BUFFER=y
CONFIG_ESP32_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP32_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP32_WIFI_AMPDU_RX_ENABLED=y

# ---- NVS Flash ----
CONFIG_NVS_FLASH_ENABLED=y

# ---- FreeRTOS ----
CONFIG_FREERTOS_HZ=1000

# ---- Partition Table ----
# 4MB 플래시 - 기본 파티션 사용 (NVS 0x6000 = 24KB)
CONFIG_PARTITION_TABLE_DEFAULT=y

# ---- 로깅 레벨 ----
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE=y

# ---- mbedtls - Ed25519 활성화 ----
CONFIG_MBEDTLS_HARDWARE_AES=y
CONFIG_MBEDTLS_HARDWARE_MPI=y
CONFIG_MBEDTLS_HARDWARE_SHA=y
CONFIG_MBEDTLS_EDDSA_C=y
CONFIG_MBEDTLS_SHA512_C=y
CONFIG_MBEDTLS_ENTROPY_C=y
CONFIG_MBEDTLS_CTR_DRBG_C=y

# ---- Arduino 컴포넌트 ----
CONFIG_AUTOSTART_ARDUINO=y

# ---- 전원 관리 (배터리+절전 모드) ----
# esp_pm_configure()를 통한 자동 라이트 슬립 + DFS
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=y
CONFIG_PM_POWER_DOWN_CPU=y
CONFIG_PM_POWER_DOWN_TAG_MEM_OFF=y
# FreeRTOS tickless idle - CPU 유휴 시 자동 슬립
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_TICKLESS_IDLE_TIME=1
# RTC 메모리 (딥슬립 간 상태 유지)
CONFIG_FREERTOS_USE_RTC_HWOPTS=y
# UART 플러시 안함 (라이트 슬립 간 USB 로그 유실 가능)
CONFIG_UART_ISR_IN_IRAM=y
