# sdkconfig.defaults.esp32s3 - ESP32-S3 전용 설정 오버라이드
#
# v27: S3 Super Mini (FH4R2: 4MB Flash + 2MB Quad PSRAM) 결정적 플래시 설정
# 이전 v26에서 bootloader.bin 헤더가 1MB/26MHz로 잘못 생성되는 문제를 해결.
#
# 적용 대상: ESP32-S3 Super Mini (FH4R2), ESP32-S3-DevKitC-1 (4MB Flash)

# ==== v27 결정적 플래시 설정 (S3 Super Mini 4MB) ====
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# ==== v27 USB CDC (S3 Super Mini native USB) ====
# TinyUSB CDC 활성화 - Serial이 UART0가 아닌 native USB로 동작
CONFIG_TINYUSB_CDC_ENABLED=y

# ==== PSRAM (S3 FH4R2: 2MB Quad PSRAM) ====
# BOARD_HAS_PSRAM=1 빌드플래그와 함께 활성화
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
# 80MHz로 설정 (40MHz보다 빠름, S3는 안정적으로 동작)
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# PSRAM 캐시 로그 비활성 (성능 + 안정)
CONFIG_SPIRAM_CACHE_DEBUG=n

# ==== CPU/클럭 ====
# v35: S3 CPU 240→160MHz 강하 (발열 감소, PSRAM 안정성 확보)
#   80MHz도 가능하지만 PSRAM(80MHz) 대역폭 처리 여유를 위해 160MHz 권장
#   듀얼코어 160MHz = C3 싱글코어 80MHz의 4배 처리량
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_160=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_MHZ=160

# ==== BLE - NimBLE (Bluedroid 비활성) ====
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BTDM_CONTROLLER_MODE_BTDM=y

# ==== NVS Flash ====
CONFIG_NVS_FLASH_ENABLED=y

# ==== FreeRTOS ====
CONFIG_FREERTOS_HZ=1000

# ==== 로깅 레벨 ====
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE=y

# ==== mbedtls - Ed25519 + RSA 2048 (cert gen용) ====
CONFIG_MBEDTLS_HARDWARE_AES=y
CONFIG_MBEDTLS_HARDWARE_MPI=y
CONFIG_MBEDTLS_HARDWARE_SHA=y
CONFIG_MBEDTLS_EDDSA_C=y
CONFIG_MBEDTLS_SHA512_C=y
CONFIG_MBEDTLS_ENTROPY_C=y
CONFIG_MBEDTLS_CTR_DRBG_C=y
# cert_gen.cpp에서 RSA 2048비트 자체 서명 인증서 생성에 필요
CONFIG_MBEDTLS_RSA_C=y
CONFIG_MBEDTLS_X509_CRT_WRITE_C=y
CONFIG_MBEDTLS_PEM_WRITE_C=y

# ==== WiFi ====
CONFIG_ESP_WIFI_ENABLED=y

# ==== Partition Table ====
CONFIG_PARTITION_TABLE_DEFAULT=y

# ==== Arduino 컴포넌트 ====
CONFIG_AUTOSTART_ARDUINO=y

# ==== v29: 절전 관리 - DFS만 활성화 (light_sleep는 BLE 비호환으로 끔) ====
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=y
CONFIG_PM_POWER_DOWN_CPU=n
CONFIG_FREERTOS_USE_TICKLESS_IDLE=n
CONFIG_FREERTOS_USE_RTC_HWOPTS=n
CONFIG_UART_ISR_IN_IRAM=y
# 브라운아웃 감지 활성
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_BROWNOUT_DET_LVL=7
